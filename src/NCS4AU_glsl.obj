--track0: 球サイズ, 0.00, 2160.00, 600.00
--track1: 高さ, 0.00, 1000.00, 64.00
--track2: 周期, 0.00, 200.00, 16.00
--track3: Z, -10000.00, 10000.00, 0.00
--dialog: 色/col,local color=0xffffff;音声同期/chk,local isReactive=1;球変換/chk,local isSpherical=1;ノイズ/chk,local applyNoise=1;サイズ,local pointerSize=6;分割数,local resolution=64;強さ,local projectionFactor=1.0;サイズ感度,local radiusReactionMultiplier=0.3;ノイズ感度,local noiseReactionMultiplier=0.2;ノイズ変異,local noiseFlowSpeed={-0.2,-0.4,0.0};

---- Pre Processing ------------------------------------------------------------
obj.setfont("MS UI Gothic", 100, 0xffffff)
obj.setoption("drawtarget", "tempbuffer", obj.screen_w, obj.screen_h)
obj.load("tempbuffer")
--------------------------------------------------------------------------------

---- Import External Modules ---------------------------------------------------
local GLShaderKit        = require "GLShaderKit"
local rikky_module       = require "rikky_module"
--------------------------------------------------------------------------------

---- Parce Tracks --------------------------------------------------------------
local sphereRadius       = obj.track0
local noiseAmplitude     = obj.track1
local noiseFrequency     = obj.track2 * 0.001
local noiseEvolution     = obj.track3

local noiseFlowSpeedX    = noiseFlowSpeed[1] * 0.1
local noiseFlowSpeedY    = noiseFlowSpeed[2] * 0.1

radiusReactionMultiplier = radiusReactionMultiplier * 0.1
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
local shaderPath         = obj.getinfo("script_path") .. "NCS4AU_glsl.frag"

local data, w, h         = obj.getpixeldata()
local screenWidth        = obj.screen_w
local screenHeight       = obj.screen_h

if GLShaderKit.isInitialized() then
	GLShaderKit.activate()

	GLShaderKit.setShader(shaderPath)
	GLShaderKit.setPointVertex(resolution * resolution) -- n = 分割数の2乗

	GLShaderKit.setInt("uResolution", resolution)
	GLShaderKit.setFloat("uScreenSize", screenWidth, screenHeight)
	GLShaderKit.setFloat("track", sphereRadius, noiseAmplitude, noiseFrequency, noiseEvolution)
	GLShaderKit.setFloat("f1", projectionFactor)
	GLShaderKit.setFloat("f2", radiusReactionMultiplier, noiseReactionMultiplier)
	GLShaderKit.setFloat("f3", noiseFlowSpeedX, noiseFlowSpeedY, 0.0)
	GLShaderKit.setInt("i3", isReactive, isSpherical, applyNoise)
	GLShaderKit.setFloat("time", obj.time)
	GLShaderKit.setFloat("uAudioStrength", 1.0)

	GLShaderKit.draw("POINTS", data, screenWidth, screenHeight)

	GLShaderKit.deactivate()
end

obj.putpixeldata(data)
--------------------------------------------------------------------------------

---- Post Processing -----------------------------------------------------------
obj.effect()
--------------------------------------------------------------------------------
